# Fabric lifecycle metadata for the deployed CCAAS chaincode.
# For a behavior-changing release, bump CHAINCODE_VERSION and CHAINCODE_SEQUENCE,
# then run ./update-release-config.sh before committing.
CHAINCODE_NAME=bank-transfer
CHAINCODE_VERSION=1.2
CHAINCODE_SEQUENCE=6
CHAINCODE_LABEL=bank-transfer_1.2
CHAINCODE_ADDRESS=fabric-chaincode.fabric.svc.cluster.local:9999
CHAINCODE_ENDORSEMENT_POLICY="OR('Org1MSP.peer','Org2MSP.peer')"
