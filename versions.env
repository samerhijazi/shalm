# =============================================================================
# Shalm Platform — Central Version File
# Sourced by CI workflows. Update here; Dependabot opens auto-PRs for most.
# =============================================================================

# --- Java / Maven -------------------------------------------------------
JAVA_VERSION=21
QUARKUS_VERSION=3.9.5
MAVEN_IMAGE_VERSION=3.9.6-eclipse-temurin-21
JRE_IMAGE_VERSION=21-jre-jammy
MAVEN_COMPILER_PLUGIN_VERSION=3.13.0
MAVEN_SUREFIRE_PLUGIN_VERSION=3.2.5

# --- GitHub Actions (Dependabot keeps these updated) --------------------
ACTION_CHECKOUT=actions/checkout@v4.2.2
ACTION_SETUP_JAVA=actions/setup-java@v4.7.0
ACTION_DOCKER_LOGIN=docker/login-action@v3.4.0
ACTION_DOCKER_BUILD_PUSH=docker/build-push-action@v5.4.0

# --- Helm Charts (update targetRevision in ArgoCD Application YAMLs) ---
HELM_KUBE_PROMETHEUS_STACK=65.1.1
HELM_PROMTAIL=6.16.6
# Loki uses raw manifests — no Helm chart version

# --- Container Registry -------------------------------------------------
REGISTRY=ghcr.io/samerhijazi
