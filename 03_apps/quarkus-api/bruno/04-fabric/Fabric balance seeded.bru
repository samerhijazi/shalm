meta {
  name: Fabric balance seeded
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/fabric/balance/{{seedAccount}}
  body: none
  auth: none
}

tests {
  test("200 with numeric balance, or 503", function () {
    expect(res.getStatus()).to.be.oneOf([200, 503]);
    if (res.getStatus() === 200) {
      expect(res.getBody().accountId).to.equal(bru.getEnvVar("seedAccount"));
      expect(res.getBody().balance).to.be.a("number").and.at.least(0);
    }
  });
}
