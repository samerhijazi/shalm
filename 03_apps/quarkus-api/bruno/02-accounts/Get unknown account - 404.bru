meta {
  name: Get unknown account - 404
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accounts/ACC-DOES-NOT-EXIST
  body: none
  auth: none
}

tests {
  test("status 404 with error message", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.contain("ACC-DOES-NOT-EXIST");
  });
}
