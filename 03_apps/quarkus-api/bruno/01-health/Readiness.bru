meta {
  name: Readiness
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("status 200 and UP", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("UP");
  });
  
  test("fabric-ledger check is UP when present", function () {
    const fabric = (res.getBody().checks || []).find(c => c.name === "fabric-ledger");
    if (fabric) {
      expect(fabric.status).to.equal("UP");
    }
  });
}
