meta {
  name: Negative amount - 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transfer
  body: json
  auth: none
}

body:json {
  {
    "from": "{{accA}}",
    "to": "{{accB}}",
    "amount": -5
  }
}

tests {
  test("status 400 invalid", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().status).to.equal("invalid");
  });
}
