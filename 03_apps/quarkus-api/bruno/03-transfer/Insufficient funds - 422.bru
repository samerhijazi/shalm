meta {
  name: Insufficient funds - 422
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/transfer
  body: json
  auth: none
}

body:json {
  {
    "from": "{{accA}}",
    "to": "{{accB}}",
    "amount": 1000000
  }
}

tests {
  test("status 422 failed", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().status).to.equal("failed");
    expect(res.getBody().fabricStatus).to.be.oneOf([null, undefined]);
  });
}
